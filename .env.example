# ---- Brain: Claude ----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
JARVIS_MODEL=claude-opus-5
JARVIS_MAX_TOKENS=2048
# Set above 1024 to let J.A.R.V.I.S. think before answering (slower, sharper)
JARVIS_THINKING_BUDGET=0

# ---- Memory: Obsidian -------------------------------------------------
# The folder that contains your .obsidian directory
OBSIDIAN_VAULT_PATH=/Users/you/Documents/Obsidian/Vault
# Subfolder inside the vault that J.A.R.V.I.S. owns
OBSIDIAN_SUBFOLDER=JARVIS

# ---- Voice: Fish Audio ------------------------------------------------
FISH_AUDIO_API_KEY=
# reference_id of your J.A.R.V.I.S. voice model on fish.audio
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s1
FISH_AUDIO_FORMAT=mp3
JARVIS_SPEECH_ENABLED=true

# ---- Persona ----------------------------------------------------------
JARVIS_NAME=J.A.R.V.I.S.
JARVIS_USER_NAME=Sir
# Optional: path to a file replacing the built-in system prompt
JARVIS_PERSONA_FILE=

# ---- Server -----------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=5000
JARVIS_DEBUG=false
JARVIS_SECRET_KEY=change-me
JARVIS_HISTORY_TURNS=20
